<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Reel Saver — Download Instagram Reels</title>
<link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}" />
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ctext y='20' font-size='20'%3E%F0%9F%8E%AC%3C/text%3E%3C/svg%3E"/>
</head>
<body>
  <div class="bg-blob blob-1"></div>
  <div class="bg-blob blob-2"></div>

  <main class="container">
    <header class="hero">
      <div class="logo">
        <span class="logo-icon">🎬</span>
        <span class="logo-text">Reel Saver</span>
      </div>
      <h1>Download Instagram Reels<br/><span class="accent">in one click</span></h1>
      <p class="subtitle">Paste a public Instagram Reel link and save the video as MP4. Fast, free, no signup.</p>
    </header>

    <section class="card">
      <form id="reel-form" class="input-row" autocomplete="off">
        <input
          type="url"
          id="url"
          name="url"
          placeholder="https://www.instagram.com/reel/…"
          required
        />
        <button type="submit" id="submit-btn">
          <span class="btn-label">Fetch</span>
          <span class="btn-spinner" aria-hidden="true"></span>
        </button>
      </form>
      <p class="hint">Works with public Reels, posts and IGTV links.</p>

      <div id="message" class="message" hidden></div>

      <div id="result" class="result" hidden>
        <div class="result-thumb">
          <img id="thumb" alt="Reel thumbnail" />
        </div>
        <div class="result-info">
          <h3 id="title">Reel</h3>
          <p id="meta" class="meta"></p>
          <div class="result-actions">
            <a id="download-link" class="btn primary" href="#">⬇ Download MP4</a>
            <button id="preview-btn" type="button" class="btn ghost">Preview</button>
          </div>
        </div>
      </div>

      <div id="preview-wrap" class="preview-wrap" hidden>
        <video id="preview-video" controls playsinline></video>
      </div>
    </section>

    <section id="history-section" class="history" hidden>
      <div class="history-header">
        <h2>Recent downloads</h2>
        <button id="clear-history" type="button" class="link-btn">Clear all</button>
      </div>
      <ul id="history-list" class="history-list"></ul>
    </section>

    <section class="how">
      <h2>How it works</h2>
      <ol>
        <li><strong>Copy</strong> the link to a public Instagram Reel.</li>
        <li><strong>Paste</strong> it in the box above and tap Fetch.</li>
        <li><strong>Download</strong> the MP4 to your device.</li>
      </ol>
    </section>

    <footer class="footer">
      <p>Only download content you have the right to use. Respect creators and Instagram’s terms.</p>
    </footer>
  </main>

  <script src="{{ url_for('static', filename='app.js') }}"></script>
</body>
</html>

